# Cogrid Agent Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 安装依赖
COPY agent/pyproject.toml ./
RUN pip install --no-cache-dir httpx psutil docker typer rich

# 复制代码和入口脚本
COPY agent/ ./agent/
COPY agent/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 环境变量
ENV PYTHONPATH=/app
ENV COGRID_COORDINATOR_URL=http://coordinator:8000/api/v1
# 认证（可选）：设置后 Agent 启动时自动登录/注册
# COGRID_USERNAME / COGRID_PASSWORD 或 COGRID_AUTH_TOKEN

ENTRYPOINT ["/app/entrypoint.sh"]
